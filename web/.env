# Where this console is pointed, by default.
#
# Committed on purpose. None of it is a secret: the address is published in the
# README, the deployment record and the end-to-end report, and a console that
# cannot be run without a setup step nobody mentioned is a console nobody runs.
#
# To point it somewhere else, put the same names in web/.env.local, or set them
# as real environment variables -- both take precedence over this file and
# neither is committed. deploy/check_records.py keeps this address honest: it
# fails if this file stops naming the contract the deployment record describes.
NEXT_PUBLIC_GENLAYER_NETWORK=studio-next
NEXT_PUBLIC_CHAIN_ID=61997
NEXT_PUBLIC_SPECLOCK_CONTRACT_ADDRESS=0x6744F203A6D17B6Ae2D1d3fE944F5a3e02Bfe2E9
